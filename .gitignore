.cproject_settings
*.launch

# =====================================================
#  Keil MDK-ARM
# =====================================================
# Build output directories
MDK-ARM/Objects/
MDK-ARM/Listings/
MDK-ARM/RTE/
MDK-ARM/DebugConfig/
# Build output directory defined in the project (objects + listings)
MDK-ARM/Encoder_localization/

# Per-user GUI state and options (the project file .uvprojx IS tracked)
MDK-ARM/*.uvguix*
MDK-ARM/*.uvoptx
MDK-ARM/*.uvopt
MDK-ARM/*.scvd
MDK-ARM/*.uvmpw
MDK-ARM/JLinkLog.txt
MDK-ARM/JLinkSettings.ini
MDK-ARM/*.htm
MDK-ARM/*.bak

